{
  "name": "optic",
  "version": "0.1.0",
  "private": true,
  "description": "An independent Kubernetes desktop workbench",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && node tests/smoke.mjs && node tests/resource-actions-smoke.mjs && node tests/advanced-streams-smoke.mjs && node tests/overview-history-smoke.mjs && node tests/cost-dashboard-smoke.mjs && node tests/security-smoke.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.1",
    "@tanstack/react-table": "^8.21.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.577.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^8.12.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "electron": "^45.0.0",
    "electron-builder": "latest",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "org.clusterworkbench.desktop",
    "productName": "Optic",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "resources/logo.png"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "logo.png",
          "icon.ico"
        ]
      }
    ]
  }
}
